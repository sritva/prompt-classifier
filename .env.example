# Database URL for SQLite (defaults to ./prompt_classifier.db if left blank)
DATABASE_URL=sqlite:///./prompt_classifier.db

# OpenAI API Key (leave empty to automatically use local heuristic fallback classifier)
OPENAI_API_KEY=

# Optional Custom Base URL (e.g., for OpenRouter: https://openrouter.ai/api/v1)
OPENAI_BASE_URL=

# Optional Custom Model Name (defaults to gpt-4o-mini; e.g. for OpenRouter: nvidia/nemotron-3-super-120b-a12b:free)
CLASSIFIER_MODEL=

