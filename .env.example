# Database URL (defaults to sqlite:///./prompt_classifier.db for local dev; use PostgreSQL like Neon for serverless/production)
DATABASE_URL=sqlite:///./prompt_classifier.db
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Works with any OpenAI-API-compatible provider (OpenAI, OpenRouter, Azure OpenAI, etc.) — set the base URL and key for your provider below.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1 # example default: OpenRouter
CLASSIFIER_MODEL=nvidia/nemotron-3-super-120b-a12b:free # example default: OpenRouter

